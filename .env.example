# React (CRA) front-end environment.
# Ise `.env` mein copy karo — `.env` gitignored hai, ye file repo mein rehti hai.
#
# CRA sirf REACT_APP_ se shuru hone wale vars parhta hai, aur value build/start
# ke waqt inline hoti hai — is liye .env badalne ke baad dev server RESTART karna
# zaroori hai.

# Django backend ka base URL (trailing /api, bina aakhri slash ke)
REACT_APP_API_URL=http://localhost:8000/api
